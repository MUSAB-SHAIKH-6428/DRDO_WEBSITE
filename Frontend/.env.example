# ==============================================================================
# DRDO RAC Defence Tech - Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Groq API Key (Optional) - Used for ultra-fast Llama-3 evaluation inference
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini API Key (Optional) - Alternative AI evaluation engine (e.g. gemini-1.5-flash / gemini-2.0-flash)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Note: If neither API key is provided, the backend seamlessly falls back to the
# built-in high-fidelity DRDO deterministic evaluation engine without crashing.
